generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Board
// ---------------------------------------------------------------------------

model Board {
  id                     String      @id @default(cuid())
  name                   String
  maxSteps               Int         @default(10)
  refreshIntervalSeconds Int         @default(5)
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  tickets    Ticket[]
  ticketTypes TicketType[]
  teams      Team[]
  people     Person[]
  swimlanes  Swimlane[]
  colorRules ColorRule[]
}

// ---------------------------------------------------------------------------
// TicketType
// ---------------------------------------------------------------------------

model TicketType {
  id                  String   @id @default(cuid())
  boardId             String
  name                String
  key                 String   // short key like "BUG", "TASK"
  defaultColorHex     String   @default("#6366f1") // indigo
  stepIntervalSeconds Int      @default(180)
  createdAt           DateTime @default(now())

  board   Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tickets Ticket[]

  @@unique([boardId, key])
}

// ---------------------------------------------------------------------------
// Team
// ---------------------------------------------------------------------------

model Team {
  id        String   @id @default(cuid())
  boardId   String
  name      String
  createdAt DateTime @default(now())

  board   Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tickets Ticket[]
}

// ---------------------------------------------------------------------------
// Person
// ---------------------------------------------------------------------------

model Person {
  id        String   @id @default(cuid())
  boardId   String
  name      String
  createdAt DateTime @default(now())

  board   Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tickets Ticket[]
}

// ---------------------------------------------------------------------------
// Swimlane
// ---------------------------------------------------------------------------

model Swimlane {
  id              String @id @default(cuid())
  boardId         String
  name            String
  order           Int
  filterExprJson  Json   @default("{}")   // expression tree: AND/OR groups
  onDropPatchJson Json   @default("{}")   // partial update applied on drop
  isCatchAll      Boolean @default(false)
  createdAt       DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId, order])
}

// ---------------------------------------------------------------------------
// ColorRule
// ---------------------------------------------------------------------------

model ColorRule {
  id           String @id @default(cuid())
  boardId      String
  order        Int
  whenExprJson Json   // expression tree: AND/OR groups with stepIndex support
  colorHex     String
  createdAt    DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId, order])
}

// ---------------------------------------------------------------------------
// Ticket
// ---------------------------------------------------------------------------

enum TicketStatus {
  TODO
  ACTIVE
  DONE
}

model Ticket {
  id          String       @id @default(cuid())
  boardId     String
  title       String
  description String?
  typeId      String
  assigneeId  String?
  teamId      String?
  status      TicketStatus @default(TODO)
  orderKey    Float        @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  startedAt   DateTime?
  doneAt      DateTime?

  board    Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  type     TicketType  @relation(fields: [typeId], references: [id])
  assignee Person?     @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  team     Team?       @relation(fields: [teamId], references: [id], onDelete: SetNull)
  events   AuditEvent[]

  @@index([boardId, status])
}

// ---------------------------------------------------------------------------
// AuditEvent
// ---------------------------------------------------------------------------

enum AuditEventType {
  TICKET_CREATED
  STATUS_CHANGED
  TITLE_UPDATED
  DESCRIPTION_UPDATED
  TYPE_CHANGED
  ASSIGNEE_CHANGED
  TEAM_CHANGED
  SWIMLANE_DROPPED
  ORDER_CHANGED
}

model AuditEvent {
  id        String         @id @default(cuid())
  ticketId  String
  type      AuditEventType
  dataJson  Json           @default("{}")
  createdAt DateTime       @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}
